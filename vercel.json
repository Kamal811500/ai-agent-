{
  "$schema": "https://openapi.vercel.sh",
  "buildCommand": "cd interview-agent/backend && pip install -r requirements.txt",
  "startCommand": "cd interview-agent/backend && python main.py",
  "outputDirectory": ".",
  "framework": "python",
  "python": {
    "version": "3.12"
  },
  "env": {
    "ANTHROPIC_API_KEY": "@ANTHROPIC_API_KEY",
    "DEBUG": "false",
    "LOG_LEVEL": "INFO",
    "PORT": "8000",
    "PYTHONUNBUFFERED": "1"
  },
  "functions": {
    "interview-agent/backend/main.py": {
      "runtime": "python3.12",
      "memory": 512,
      "maxDuration": 60
    }
  },
  "regions": ["iad1"],
  "trailingSlash": false
}
